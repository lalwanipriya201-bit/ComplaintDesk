@model IEnumerable<ComplaintMgtSystem.Models.Category>

@{
    ViewData["Title"] = "Manage categories";
}

<div class="container">
    <header class="page-header">
        <div>
            <p class="eyebrow">Administration</p>
            <h1>Manage categories</h1>
            <p>Keep the complaint categories clear and useful for everyone.</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Category" asp-action="Create" class="btn btn-primary">Add category</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section class="card" aria-labelledby="categoriesHeading">
        <div class="card-header d-flex justify-content-between align-items-center gap-3">
            <h2 id="categoriesHeading" class="h5 mb-0">Complaint categories</h2>
            <span class="text-muted small">@Model.Count() total</span>
        </div>

        @if (Model.Any())
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Category name</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td class="text-muted">@category.Id</td>
                                    <td class="fw-semibold">@category.Name</td>
                                    <td class="text-end action-cell">
                                        <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                            <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteCategory-@category.Id" aria-label="Delete @category.Name">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @foreach (var category in Model)
            {
                <div class="modal fade" id="deleteCategory-@category.Id" tabindex="-1" aria-labelledby="deleteCategoryLabel-@category.Id" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title h5" id="deleteCategoryLabel-@category.Id">Delete category?</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Delete <strong>@category.Name</strong>?</p>
                                <p class="text-muted small mb-0">Categories used by complaints cannot be deleted.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger">Delete category</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-mark" aria-hidden="true">＋</div>
                <h3 class="h5">No categories yet</h3>
                <p>Add a category to make it available when a complaint is submitted.</p>
                <a asp-controller="Category" asp-action="Create" class="btn btn-primary">Add category</a>
            </div>
        }
    </section>

    <div class="mt-3">
        <a asp-controller="Dashboard" asp-action="AdminDashboard" class="btn btn-outline-secondary">Back to overview</a>
    </div>
</div>

