@model ComplaintMgtSystem.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create account";
}

<div class="container">
    <div class="auth-wrap">
        <section class="card auth-card" aria-labelledby="registerHeading">
            <div class="card-body">
                <div class="auth-brand-mark" aria-hidden="true">C</div>
                <h1 id="registerHeading" class="h2 auth-heading">Create your account</h1>
                <p class="auth-intro">Register to submit an issue and follow its progress.</p>

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Full name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your full name" autocomplete="name" autofocus />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Enter your password again" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create account</button>
                </form>

                <p class="text-center mt-4 mb-0">Already registered?
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

