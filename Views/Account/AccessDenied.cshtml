@{
    ViewData["Title"] = "Access denied";
}

<div class="container">
    <section class="card auth-card mx-auto my-4" aria-labelledby="deniedHeading">
        <div class="card-body text-center">
            <div class="auth-brand-mark" aria-hidden="true">!</div>
            <p class="access-code">403</p>
            <h1 id="deniedHeading" class="h2 mt-3">Access denied</h1>
            <p class="text-muted mt-3 mb-4">
                This page is limited to accounts with the required access. Sign in with the appropriate account or return to the home page.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Go to sign in</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to home</a>
            </div>
        </div>
    </section>
</div>

