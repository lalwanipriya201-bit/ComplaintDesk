@model ComplaintMgtSystem.Models.Complaint

@{
    ViewData["Title"] = "Submit a complaint";
}

<div class="container">
    <header class="page-header">
        <div>
            <p class="eyebrow">New request</p>
            <h1>Submit a complaint</h1>
            <p>Describe the issue clearly so it can be directed to the right team.</p>
        </div>
    </header>

    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <section class="card surface-card">
                <div class="card-body p-lg-4">
                    <form asp-controller="Complaint" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Subject" class="form-label">Subject <span class="required-mark" aria-hidden="true">*</span></label>
                            <input asp-for="Subject" class="form-control" maxlength="150" placeholder="A short summary of the issue" required />
                            <span asp-validation-for="Subject" class="field-validation-error"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">Description <span class="required-mark" aria-hidden="true">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="6" maxlength="2000" placeholder="Include relevant details, location, and when the issue occurred." required></textarea>
                            <div class="field-hint">Please avoid including sensitive account or payment details.</div>
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-7">
                                <label asp-for="CategoryId" class="form-label">Category <span class="required-mark" aria-hidden="true">*</span></label>
                                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required>
                                    <option value="">Choose a category</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Priority" class="form-label">Priority <span class="required-mark" aria-hidden="true">*</span></label>
                                <select asp-for="Priority" class="form-select" required>
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected="@(Model?.Priority == "Medium" || Model?.Priority is null)">Medium</option>
                                    <option value="High">High</option>
                                </select>
                                <span asp-validation-for="Priority" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button type="submit" class="btn btn-primary">Submit complaint</button>
                            <a asp-controller="Complaint" asp-action="MyComplaints" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

